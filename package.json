{
  "name": "@dev-rookiestar/dsh-sound-plugin",
  "version": "1.0.0",
  "description": "Plays a system sound when the AI finishes responding or a pending approval appears in DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "engines": { "dsh": ">=0.2.0 <0.3.0" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings-general"]
    }
  }
}
